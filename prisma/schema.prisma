generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // plain text, admin creates accounts
  name      String
  role      String   @default("engineer") // admin, engineer, viewer
  createdAt DateTime @default(now())

  projects      ProjectMember[]
  uploadedFiles File[]
}

model Project {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. PJ-TAS-1001
  type        String   // PJ, STC, TO, TEO, AO, EA
  region      String   // TAS, SUR, SAM, BUX, FER, AND, NAM, NAV, QAS, JIZ, SIR, XOR, KAR
  internalId  Int      // 1001, 2050, etc.
  name        String   // Human-readable name
  description String?
  status      String   @default("active") // active, completed, archived
  progress    Int      @default(0) // 0-100
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members ProjectMember[]
  files   File[]
}

model ProjectMember {
  id        String @id @default(cuid())
  userId    String
  projectId String
  role      String @default("engineer") // lead, engineer, viewer

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model File {
  id         String   @id @default(cuid())
  name       String
  path       String
  size       Int
  mimeType   String
  category   String   @default("document") // document, photo, video
  projectId  String
  uploadedBy String
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User   @relation(fields: [uploadedBy], references: [id])
}
