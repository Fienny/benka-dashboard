generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  roles         UserRole[]
  projects      ProjectMember[]
  uploadedFiles File[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // Admin, Engineer, Viewer
  description String?
  createdAt   DateTime @default(now())

  users UserRole[]
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Project {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. PJ-TAS-1001
  type        String   // PJ, STC, TO, TEO, AO, EA
  region      String   // TAS, SUR, SAM, BUX, FER, AND, NAM, NAV, QAS, JIZ, SIR, XOR, KAR
  internalId  Int      // 1001, 2050, etc.
  name        String   // Human-readable name
  description String?
  status      String   @default("active") // active, completed, archived
  progress    Int      @default(0) // 0-100
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members ProjectMember[]
  files   File[]
}

model ProjectMember {
  id        String @id @default(cuid())
  userId    String
  projectId String
  role      String @default("engineer") // lead, engineer, viewer

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model File {
  id         String   @id @default(cuid())
  name       String
  path       String
  size       Int
  mimeType   String
  category   String   @default("document") // document, photo, video
  projectId  String
  uploadedBy String
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User   @relation(fields: [uploadedBy], references: [id])
}
